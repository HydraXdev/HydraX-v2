  "zmq_architecture": {
    "description": "Complete ZeroMQ communication architecture",
    "pattern": "DEALER/ROUTER + PUSH/PULL",

    "port_5555": {
      "name": "Command Routing (Bidirectional)",
      "server_socket": "ROUTER",
      "ea_socket": "DEALER",
      "server_binds": "tcp://*:5555",
      "ea_connects": "tcp://134.199.204.67:5555",
      "ea_identity": "COMMANDER_DEV_001 (set via ZMQ_IDENTITY)",
      "message_flow": [
        "Server → EA: fire, close, close_all, ping commands",
        "EA → Server: dealer_heartbeat (5s keepalive), pong responses"
      ],
      "server_component": "command_router.py (PID varies)",
      "ea_socket_variable": "g_cmd_dealer",
      "routing_mechanism": "ROUTER uses EA identity to direct messages",
      "keepalive": "EA sends dealer_heartbeat every 5 seconds to prevent timeout",
      "response_handling": "Command router waits for responses, implements timeout logic",
      "frame_structure": "[identity][empty][payload]"
    },

    "port_5556": {
      "name": "Market Data + Lifecycle Events (EA → Server)",
      "server_socket": "PULL",
      "ea_socket": "PUSH",
      "server_binds": "tcp://*:5556",
      "ea_connects": "tcp://134.199.204.67:5556",
      "message_flow": [
        "EA → Server: tick (every tick)",
        "EA → Server: handshake (on startup)",
        "EA → Server: heartbeat (every 1 second)",
        "EA → Server: disconnect (on shutdown)"
      ],
      "server_component": "zmq_telemetry_bridge_debug.py",
      "ea_socket_variable": "g_tick_pub",
      "relay_to": "Port 5560 (republished for subscribers)",
      "purpose": "Raw market data streaming for pattern detection",
      "volume": "500-1000 ticks/minute during active trading",
      "consumers": [
        "elite_guard_with_citadel.py (subscribes to 5560)",
        "Pattern detection algorithms",
        "Candle building systems"
      ]
    },

    "port_5558": {
      "name": "Trade Confirmations + Position Lifecycle (EA → Server)",
      "server_socket": "PULL",
      "ea_socket": "PUSH",
      "server_binds": "tcp://*:5558",
      "ea_connects": "tcp://134.199.204.67:5558",
      "message_flow": [
        "EA → Server: confirmation (fire/close result)",
        "EA → Server: position_opened (new trade)",
        "EA → Server: position_closed (TP/SL/manual close)",
        "EA → Server: pong (ping response)"
      ],
      "server_component": "confirm_listener.py (PID varies)",
      "ea_socket_variable": "g_confirm_pub",
      "purpose": "Track trade execution and position lifecycle",
      "volume": "10-20 messages/hour during trading",
      "database_updates": [
        "fires table (status, ticket, price)",
        "live_positions table (position tracking)",
        "Position closure events"
      ],
      "event_bus_integration": "Publishes to event_bus for slot management and analytics"
    },

    "port_5560": {
      "name": "Account Metrics + Position Updates (EA → Server → Subscribers)",
      "server_socket": "PUB (after relay from 5556)",
      "ea_socket": "PUSH",
      "server_binds": "tcp://*:5560 (PUB socket)",
      "ea_connects": "tcp://134.199.204.67:5560",
      "relay_source": "Port 5556 (telemetry bridge republishes)",
      "message_flow": [
        "EA → Server (5556): tick, heartbeat",
        "Server → Subscribers (5560): republished data",
        "EA → Server (5560): position_update (1/sec per position)"
      ],
      "server_component": "zmq_telemetry_bridge_debug.py (relay)",
      "ea_socket_variable": "g_metrics_pub",
      "purpose": [
        "Real-time position monitoring",
        "Account health metrics",
        "Market data distribution"
      ],
      "subscribers": [
        "elite_guard_with_citadel.py (pattern detection)",
        "webapp_server_optimized.py (live displays)",
        "Analytics systems"
      ],
      "pub_sub_model": "Subscribers can filter by message type"
    },

    "ipc_queue": {
      "name": "Internal Process Communication",
      "endpoint": "ipc:///tmp/bitten_cmdqueue",
      "pattern": "PUSH/PULL",
      "producer": "enqueue_fire.py (fire command generation)",
      "consumer": "command_router.py (routes to EA)",
      "purpose": "Decouples fire generation from EA communication",
      "message_format": "JSON fire commands",
      "benefits": [
        "Process isolation",
        "Async fire command queuing",
        "Failure isolation (if router crashes, commands queued)",
        "Multiple producers can enqueue"
      ]
    },

    "server_processes": {
      "command_router": {
        "file": "/root/HydraX-v2/command_router.py",
        "port": 5555,
        "socket_type": "ROUTER",
        "responsibilities": [
          "Pull commands from IPC queue",
          "Route to EA via UUID",
          "Handle responses",
          "Update ea_instances heartbeat",
          "Implement command timeout"
        ],
        "pm2_name": "command_router",
        "critical": true
      },
      "zmq_telemetry_bridge": {
        "file": "/root/HydraX-v2/zmq_telemetry_bridge_debug.py",
        "ports": "5556 (PULL), 5560 (PUB)",
        "responsibilities": [
          "Receive ticks/heartbeats from EA (5556)",
          "Republish to subscribers (5560)",
          "Act as message relay",
          "No processing, just forwarding"
        ],
        "pm2_name": "zmq_telemetry_bridge",
        "critical": true
      },
      "confirm_listener": {
        "file": "/root/HydraX-v2/confirm_listener.py",
        "port": 5558,
        "socket_type": "PULL",
        "responsibilities": [
          "Receive confirmations",
          "Update fires database",
          "Process position_opened events",
          "Process position_closed events",
          "Release user slots on closure",
          "Publish to event bus"
        ],
        "pm2_name": "confirm_listener",
        "critical": true
      }
    }
  },

  "critical_fixes": {
    "september_22_2025_fire_packet_format": {
      "issue": "EA v2.07 extremely strict about JSON format",
      "root_cause": "Field order, data types, extra fields caused trade failures",
      "symptoms": [
        "Fire status = 'SENT' but never 'FILLED'",
        "EA logs show 'drop confirm without fire_id'",
        "No MT5 ticket number generated"
      ],
      "solution": {
        "file": "/root/HydraX-v2/enqueue_fire.py",
        "lines": "464-500",
        "changes": [
          "Use OrderedDict to enforce field order",
          "'type' MUST be first field",
          "Direction must be UPPERCASE (BUY/SELL)",
          "Numbers NOT quoted (0.10 not '0.10')",
          "Lot rounded to 2 decimals (line 40)",
          "Entry=0 for market orders",
          "NO extra fields (user_id removed)"
        ]
      },
      "verification": {
        "test_date": "2025-09-22",
        "test_signal": "ELITE_RAPID_GBPJPY_1756773488",
        "result": "FILLED with ticket 21173956 at price 199.425",
        "confirmation": "Position opened event received successfully"
      },
      "documentation_location": "CLAUDE.md lines 86-182"
    },

    "august_15_2025_invalid_volume": {
      "issue": "MT5 rejecting trades with invalid volume format",
      "root_cause": "Lot sizes like 0.09447600000000202 not rounded",
      "symptoms": [
        "Fire status = 'FAILED'",
        "Ticket = 0, Price = 0",
        "EA logs show volume errors"
      ],
      "solution": {
        "file": "/root/HydraX-v2/enqueue_fire.py",
        "line": 40,
        "change": "lot = round(lot, 2)",
        "impact": "All lot sizes now properly rounded (0.09 not 0.094476)"
      },
      "verification": {
        "test_date": "2025-08-15",
        "test_signal": "ELITE_GUARD_GBPUSD_1755223898",
        "result": "FILLED with ticket 20813351 at price 1.35357",
        "lot": "0.09 (properly rounded)"
      }
    },

    "august_13_2025_test_dealer_interception": {
      "issue": "Fire commands not reaching real EA",
      "root_cause": "Test DEALER process (PID 3311456) masquerading as COMMANDER_DEV_001",
      "symptoms": [
        "Fire status shows 'FILLED' but no MT5 execution",
        "Fake confirmations generated by test process",
        "Real EA never receives commands"
      ],
      "solution": {
        "action": "Kill test DEALER process",
        "command": "kill 3311456",
        "prevention": "Always check for test processes before debugging EA communication"
      },
      "detection": {
        "command": "ps aux | grep -E 'test.*dealer|dealer.*test'",
        "action": "Kill any found test processes"
      }
    }
  },

