  "communication_protocols": {
    "fire_command": {
      "description": "Execute trade command from server to EA",
      "port": 5555,
      "direction": "Server (ROUTER) → EA (DEALER)",
      "format": "JSON with EXACT field order (CRITICAL)",
      "required_fields": [
        "type",
        "target_uuid",
        "fire_id",
        "symbol",
        "direction",
        "entry",
        "sl",
        "tp",
        "lot"
      ],
      "field_order": "MANDATORY - 'type' MUST be first field",
      "field_types": {
        "type": "string (always 'fire')",
        "target_uuid": "string (EA UUID)",
        "fire_id": "string (unique signal identifier)",
        "symbol": "string (MT5 symbol name)",
        "direction": "string (UPPERCASE: BUY or SELL only)",
        "entry": "number (0 for market orders)",
        "sl": "number (stop loss price, can be 0)",
        "tp": "number (take profit price, can be 0)",
        "lot": "number (rounded to 2 decimals)"
      },
      "critical_rules": [
        "Field order matters - use OrderedDict in Python",
        "Direction MUST be uppercase (BUY/SELL, not buy/sell)",
        "Numbers must NOT be quoted (0.10 not '0.10')",
        "Entry=0 means market order (EA uses current price)",
        "SL/TP can be 0 (means unset)",
        "Lot must be rounded to 2 decimals (0.09 not 0.094476)",
        "NO extra fields beyond the 9 required",
        "Hybrid config is optional (for BITMODE)"
      ],
      "examples": [
        {
          "description": "Basic market order",
          "json": {
            "type": "fire",
            "target_uuid": "COMMANDER_DEV_001",
            "fire_id": "ELITE_GUARD_EURUSD_1755223898",
            "symbol": "EURUSD",
            "direction": "BUY",
            "entry": 0,
            "sl": 1.09500,
            "tp": 1.10000,
            "lot": 0.10
          }
        },
        {
          "description": "With BITMODE hybrid config",
          "json": {
            "type": "fire",
            "target_uuid": "COMMANDER_DEV_001",
            "fire_id": "ELITE_RAPID_GBPJPY_1756773488",
            "symbol": "GBPJPY",
            "direction": "SELL",
            "entry": 0,
            "sl": 199.650,
            "tp": 199.200,
            "lot": 0.45,
            "hybrid": {
              "enabled": true,
              "partial1": {"trigger": 8, "percent": 25},
              "partial2": {"trigger": 12, "percent": 25},
              "trail": {"distance": 8}
            }
          }
        }
      ],
      "common_failures": [
        "❌ Including user_id field (EA doesn't expect it)",
        "❌ Using lowercase 'buy' or 'sell' (must be BUY/SELL)",
        "❌ Quoted numbers like '0.10' (must be unquoted)",
        "❌ Python True/False instead of JSON true/false",
        "❌ Unrounded lot sizes like 0.1034567",
        "❌ Wrong field order (type must be first)"
      ],
      "implementation_location": "/root/HydraX-v2/enqueue_fire.py lines 464-584"
    },

