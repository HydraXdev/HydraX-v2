  "configuration": {
    "inputs": {
      "InpVerboseLogging": {
        "type": "bool",
        "default": false,
        "description": "Toggle detailed logging and comments"
      },
      "InpBlockOppositeHedge": {
        "type": "bool",
        "default": true,
        "description": "Block opposite side positions on same symbol"
      },
      "InpMaxSpreadPoints": {
        "type": "double",
        "default": 0.0,
        "description": "0=off; else reject if spread > limit (points)"
      },
      "InpDeviationPoints": {
        "type": "int",
        "default": 5,
        "description": "Slippage/deviation for market orders (points)"
      },
      "InpTelemetryBeatSec": {
        "type": "int",
        "default": 1,
        "description": "Heartbeat+metrics cadence (seconds)"
      },
      "InpRouterBeatSec": {
        "type": "int",
        "default": 5,
        "description": "Router heartbeat cadence (seconds)"
      },
      "InpStreamTicks": {
        "type": "bool",
        "default": true,
        "description": "Enable deterministic tick streaming"
      },
      "InpStreamOHLC": {
        "type": "bool",
        "default": true,
        "description": "Enable OHLC streaming"
      },
      "InpSnapshotBars": {
        "type": "int",
        "default": 100,
        "description": "Number of bars in signal snapshots"
      },
      "InpSnapshotTF": {
        "type": "string",
        "default": "M1",
        "description": "Timeframe for snapshots",
        "allowed_values": ["M1", "M5", "M15", "M30", "H1"]
      }
    }
