"use client"

import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { TrendingUp, TrendingDown, Zap, PlayCircle } from 'lucide-react';
import { useReducedMotion } from '@/lib/ui/a11y';
import { fmtPrice, fmtPips, fmtUSD, fmtTime } from '@/lib/ui/format';
import type { UserProfile, AlertData } from '@/lib/eventBus/contracts';
import { HeaderOps } from './HeaderOps';
import { HelpMenuButtons } from './HelpMenuButtons';
import { AmmoBar } from './AmmoBar';
import { DossierKV, DossierSection } from './DossierKV';
import { Legend, LEGEND_PRESETS } from './Legend';

export interface MissionBriefProps {
  user: UserProfile;
  alert: AlertData;
  onExecute: () => void;
  onGotoStatus: () => void;
  onOpenNotebook: () => void;
  onOpenMenu: () => void;
  onOpenHelp: () => void;
}

/**
 * MissionBrief - Signal briefing with execute action
 *
 * Flow: Brief → Execute → Auto-redirect to Status
 *
 * Features:
 * - Alert panel with pattern, pair, confidence, R:R
 * - Tactical chart with TP/Entry/SL visualization
 * - Mission dossier (KV rows)
 * - AmmoBar for capacity
 * - Primary CTA: Execute Trade
 * - Hotkeys: E (execute), D (status), N (notebook), ? (help)
 * - A11y: aria-live regions, tabular numerals, motion guards
 */
export function MissionBrief({
  user,
  alert,
  onExecute,
  onGotoStatus,
  onOpenNotebook,
  onOpenMenu,
  onOpenHelp,
}: MissionBriefProps) {
  const [showConfirm, setShowConfirm] = useState(false);
  const [riskAcknowledged, setRiskAcknowledged] = useState(false);
  const prefersReducedMotion = useReducedMotion();

  const handleExecuteClick = () => {
    setShowConfirm(true);
  };

  const handleConfirmExecute = () => {
    if (!riskAcknowledged) return;
    onExecute();
    setTimeout(() => onGotoStatus(), 500); // Auto-redirect after execution
  };

  const direction = alert.direction || (alert.takeProfit > alert.entry ? 'BUY' : 'SELL');
  const riskAmount = user.riskPerTrade;
  const rewardAmount = riskAmount * alert.riskReward;

  // NOTE: Real implementation would calculate position size based on account currency, pair, and risk%
  const positionSize = (riskAmount / (alert.pips.sl * 10)).toFixed(2);

  return (
    <div className="min-h-screen bg-[#0a0e1a] text-[#cbd5e0]">
      {/* Header */}
      <HeaderOps
        pageTitle="MISSION BRIEF"
        userLevel={user.level}
      />

      {/* Help & Menu Buttons */}
      <HelpMenuButtons
        onHelp={onOpenHelp}
        onMenu={onOpenMenu}
      />

      <div className="max-w-5xl mx-auto px-4 py-8 pb-24">
        {/* Alert Panel */}
        <motion.div
          initial={prefersReducedMotion ? {} : { opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="bg-[#1a1f2e] border border-[#34d399]/30 rounded-lg p-6 mb-6"
        >
          {/* Pattern Header */}
          <div className="flex items-start justify-between mb-4">
            <div>
              <div className="flex items-center gap-3 mb-2">
                <Zap className="w-6 h-6 text-[#34d399]" aria-hidden="true" />
                <h1 className="text-2xl font-tactical text-[#34d399]">{alert.pattern.replace(/_/g, ' ')}</h1>
              </div>
              <p className="text-sm text-[#4a5568]">
                {alert.pair} • {alert.timeframe} • {alert.session} Session
              </p>
            </div>
            <div className="text-right">
              <div className="text-3xl font-tactical text-[#34d399] mb-1" aria-live="polite">
                {alert.confidence}%
              </div>
              <p className="text-xs text-[#4a5568]">CONFIDENCE</p>
            </div>
          </div>

          {/* Metadata Row */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div>
              <p className="text-xs text-[#4a5568] mb-1">DIRECTION</p>
              <p className={`text-lg font-tactical ${direction === 'BUY' ? 'text-[#34d399]' : 'text-[#ef4444]'}`}>
                {direction === 'BUY' ? <TrendingUp className="w-5 h-5 inline mr-1" /> : <TrendingDown className="w-5 h-5 inline mr-1" />}
                {direction}
              </p>
            </div>
            <div>
              <p className="text-xs text-[#4a5568] mb-1">RISK/REWARD</p>
              <p className="text-lg font-mono tabular-nums text-[#06b6d4]">{alert.riskReward.toFixed(2)}:1</p>
            </div>
            <div>
              <p className="text-xs text-[#4a5568] mb-1">TIMESTAMP</p>
              <time className="text-sm font-mono tabular-nums text-[#cbd5e0]">{fmtTime(alert.timestamp)}</time>
            </div>
            <div>
              <p className="text-xs text-[#4a5568] mb-1">SIGNAL ID</p>
              <p className="text-xs font-mono text-[#cbd5e0] truncate">{alert.signalId || `${alert.pair}_${alert.patternId}`}</p>
            </div>
          </div>

          {/* Tactical Chart */}
          <div className="bg-[#0a0e1a] rounded-lg p-4 mb-6 relative">
            <div className="absolute top-2 right-2">
              <Legend items={LEGEND_PRESETS.zones} />
            </div>

            {/* Simple SVG chart visualization */}
            <svg viewBox="0 0 400 150" className="w-full h-40" aria-label="Trade setup visualization">
              {/* Price levels */}
              <line x1="20" y1="30" x2="380" y2="30" stroke="#34d399" strokeWidth="1" strokeDasharray="4" />
              <text x="385" y="35" fill="#34d399" fontSize="10">TP: {fmtPrice(alert.takeProfit)}</text>

              <line x1="20" y1="75" x2="380" y2="75" stroke="#cbd5e0" strokeWidth="2" />
              <text x="385" y="80" fill="#cbd5e0" fontSize="10">Entry: {fmtPrice(alert.entry)}</text>

              <line x1="20" y1="120" x2="380" y2="120" stroke="#ef4444" strokeWidth="1" strokeDasharray="4" />
              <text x="385" y="125" fill="#ef4444" fontSize="10">SL: {fmtPrice(alert.stopLoss)}</text>

              {/* Expected path */}
              <path d="M 200 75 L 280 50 L 300 30" stroke="#34d399" strokeWidth="2" fill="none" strokeDasharray="4" opacity="0.7" />

              {/* Current position marker */}
              <circle cx="200" cy="75" r="5" fill="#fbbf24" />
              <text x="200" y="90" fill="#fbbf24" fontSize="12" textAnchor="middle">YOU ARE HERE</text>
            </svg>
          </div>

          {/* Mission Dossier */}
          <DossierSection title="TRADE PARAMETERS">
            <DossierKV label="Entry Price" value={fmtPrice(alert.entry)} valueColor="primary" />
            <DossierKV label="Take Profit" value={`${fmtPrice(alert.takeProfit)} (+${fmtPips(alert.pips.tp)} pips)`} valueColor="success" />
            <DossierKV label="Stop Loss" value={`${fmtPrice(alert.stopLoss)} (-${fmtPips(alert.pips.sl)} pips)`} valueColor="danger" />
            <DossierKV label="Risk/Reward" value={`${alert.riskReward.toFixed(2)}:1`} valueColor="cyan" />
          </DossierSection>

          <DossierSection title="POSITION SIZING" className="mt-4">
            <DossierKV label="Risk Amount" value={fmtUSD(riskAmount)} valueColor="danger" />
            <DossierKV label="Reward Target" value={fmtUSD(rewardAmount)} valueColor="success" />
            <DossierKV label="Position Size" value={`${positionSize} lots`} valueColor="cyan" />
          </DossierSection>

          {/* Capacity */}
          <div className="mt-6 pt-4 border-t border-[#2d3748]">
            <div className="flex items-center justify-between">
              <span className="text-sm text-[#4a5568]">CAPACITY</span>
              <AmmoBar maxTrades={user.maxTrades} activeTrades={user.activeTrades} />
            </div>
          </div>
        </motion.div>

        {/* Execute Button */}
        {!showConfirm && (
          <motion.button
            whileHover={prefersReducedMotion ? {} : { scale: 1.02 }}
            whileTap={prefersReducedMotion ? {} : { scale: 0.98 }}
            onClick={handleExecuteClick}
            className="
              w-full bg-[#34d399] hover:bg-[#10b981] text-[#0a0e1a]
              px-8 py-4 rounded-lg font-tactical text-lg
              flex items-center justify-center gap-2
              focus:outline-none focus:ring-2 focus:ring-[#34d399] focus:ring-offset-2 focus:ring-offset-[#0a0e1a]
              transition-colors
            "
            aria-label="Execute trade (hotkey: E)"
          >
            <PlayCircle className="w-5 h-5" aria-hidden="true" />
            Execute Trade [E]
          </motion.button>
        )}

        {/* Confirm Dialog */}
        {showConfirm && (
          <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            className="bg-[#1a1f2e] border border-[#fbbf24]/30 rounded-lg p-6"
          >
            <h2 className="text-xl font-tactical text-[#fbbf24] mb-4">Confirm Execution</h2>
            <p className="text-sm text-[#cbd5e0] mb-4">
              You are about to execute a {direction} trade on {alert.pair} with {fmtUSD(riskAmount)} at risk.
            </p>

            <label className="flex items-start gap-3 mb-6 cursor-pointer">
              <input
                type="checkbox"
                checked={riskAcknowledged}
                onChange={(e) => setRiskAcknowledged(e.target.checked)}
                className="mt-1 w-4 h-4 rounded border-[#2d3748] bg-[#0a0e1a] text-[#34d399] focus:ring-2 focus:ring-[#34d399]"
              />
              <span className="text-sm text-[#cbd5e0]">
                I acknowledge the risk and have reviewed the trade parameters
              </span>
            </label>

            <div className="flex gap-4">
              <button
                onClick={handleConfirmExecute}
                disabled={!riskAcknowledged}
                className="
                  flex-1 bg-[#34d399] hover:bg-[#10b981] disabled:bg-[#2d3748] disabled:text-[#4a5568]
                  text-[#0a0e1a] px-6 py-3 rounded-lg font-tactical
                  transition-colors
                "
              >
                Confirm & Execute
              </button>
              <button
                onClick={() => setShowConfirm(false)}
                className="px-6 py-3 bg-[#2d3748] hover:bg-[#4a5568] text-[#cbd5e0] rounded-lg font-tactical transition-colors"
              >
                Cancel
              </button>
            </div>
          </motion.div>
        )}

        {/* Secondary Actions */}
        <div className="mt-4 flex gap-4">
          <button
            onClick={onOpenNotebook}
            className="flex-1 px-4 py-2 bg-[#2d3748] hover:bg-[#4a5568] text-[#cbd5e0] rounded-lg text-sm font-tactical transition-colors"
            aria-label="Open notebook (hotkey: N)"
          >
            📓 Notebook [N]
          </button>
          <button
            onClick={onGotoStatus}
            className="flex-1 px-4 py-2 bg-[#2d3748] hover:bg-[#4a5568] text-[#cbd5e0] rounded-lg text-sm font-tactical transition-colors"
            aria-label="Go to status board (hotkey: D)"
          >
            📊 Status Board [D]
          </button>
        </div>
      </div>
    </div>
  );
}
